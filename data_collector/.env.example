MOCK_SERVER_URL=http://localhost:9001
TOPO_INTERVAL_S=60
REALTIME_INTERVAL_S=10
RETENTION_HOURS=2
REALTIME_RETENTION_HOURS=24
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=<向管理员索取>
# ⚠️ 每个部署环境必须使用独立、唯一的 DB_NAME（ECS / 本地 / 队友各一个）。
# 共用同一个库会让两边的 collector 每 60s 互相覆盖 k8s_resources 快照，
# 表现为风险面板在 open/resolved 间闪动；且 ingest_data 会 DELETE 七张观测表，
# 本地跑一次 static 采集就会清空对方的 live 数据。
DB_NAME=ai_devops_cmdb_lin
