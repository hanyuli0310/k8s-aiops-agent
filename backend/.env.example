# 复制为 .env 并填入真实值（.env 已被 gitignore，勿提交）

# --- LLM：阿里云百炼（OpenAI 兼容接口）---
# Token 计划用户可直接从 ~/.bailian/config.json 取 api_key 与 base_url
# 注意 base_url 需带 /compatible-mode/v1 后缀
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-max
# 快模型：意图识别 / 上下文摘要，以及主模型连续失败时的降级兜底。
# ⚠️ 必须与 LLM_MODEL 不同，否则降级保护与分模型路由都是空转的死代码。
# 降级时会带 tools 调用，所以快模型必须支持 function calling。
# 本端点可用模型可用 client.models.list() 查询；qwen3.6-flash 已验证可用。
LLM_MODEL_FAST=qwen3.6-flash

# 若用公有云百炼标准接入，则为：
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-max
# LLM_MODEL_FAST=qwen-turbo

# --- 数据库：MySQL ---
# 推荐用分开的 DB_* 变量：密码含 # @ : / 等特殊字符时代码会自动 URL 转义，
# 直接拼 DATABASE_URL 则需自行编码（如 # 要写成 %23）。
# 注意：多人并行开发时每人用独立库（如 ai_devops_cmdb_lin / _li / _yang），避免互相覆盖数据
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=<向管理员索取>
# ⚠️ 每个部署环境必须使用独立、唯一的 DB_NAME（ECS / 本地 / 队友各一个）。
# 共用同一个库会让两边的 collector 每 60s 互相覆盖 k8s_resources 快照，
# 表现为风险面板在 open/resolved 间闪动；且 ingest_data 会 DELETE 七张观测表，
# 本地跑一次 static 采集就会清空对方的 live 数据。
DB_NAME=ai_devops_cmdb_lin

# 本地自建 MySQL 或其他场景可直接给完整 URL（优先于 DB_*）：
# DATABASE_URL=mysql+pymysql://root:<password>@127.0.0.1:3306/aiops?charset=utf8mb4
# 不配任何数据库或连不上时，自动降级本地 SQLite（backend/aiops.db），代码无需修改

# --- Mock 数据集目录（默认取仓库根 data/data，通常无需修改）---
MOCK_DATA_DIR=../data/data

# ── Agent 运行预算与上下文窗口（可选，均有默认值）──
# 预算上限：<= 0 表示【不限制】。当前默认停用熔断，目标是让 Agent 跑到任务完成；
# 用量与花费统计不受影响，仍会每步上报。要恢复封顶就设回正数。
# RUN_MAX_TOKENS=0
# RUN_MAX_WALL_S=0
# SUBAGENT_MAX_TOKENS=0
# SUBAGENT_MAX_WALL_S=0

# 单段步数上限 / 续跑段数上限（预算停用后，这两个是主要的防跑飞手段）
# MAX_AGENT_STEPS=30
# RUN_MAX_CONTINUATIONS=50

# 上下文压缩阈值。按 200k 窗口标定：est_tokens 校准后高估约 1.2x，
# 故 180000 对应真实约 150k（已实测 flash 可吃下 150,831）。
# CONTEXT_MAX_TOKENS=180000
# CONTEXT_MAX_CHARS=360000
# CONTEXT_SOFT_RATIO=0.6

# 模型单价（元/1000 tokens），仅用于展示估算花费，不参与熔断
# PRICE_IN_PER_1K=0.02
# PRICE_OUT_PER_1K=0.06
